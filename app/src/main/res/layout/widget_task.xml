<?xml version="1.0" encoding="utf-8"?>
<!-- Item de tarefa: card brute_item (16dp, cor chapada, sem outline) e SEM marcador —
     texto Inter + due. Cantos 16dp, sem sombra, sem borda. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/brute_item_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/task_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/inter"
        android:textColor="@color/brute_on_surface"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/task_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/brute_on_surface_variant"
        android:textSize="12sp" />

</LinearLayout>
